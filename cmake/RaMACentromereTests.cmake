# Independent executable from the untouched vendored snapshot. Only three
# demonstrated safety fixes are applied in the build tree, no RaMA rules changed.
set(_ref "${CMAKE_CURRENT_BINARY_DIR}/rama-reference")
file(COPY "${PROJECT_SOURCE_DIR}/third_party/rama/upstream/" DESTINATION "${_ref}")
file(READ "${_ref}/Anchor/anchor.cpp" _text)
string(REPLACE "(int_t*)malloc(concat_data_length * sizeof(int_t))"
               "(int_t*)calloc(concat_data_length, sizeof(int_t))" _text "${_text}")
file(WRITE "${_ref}/Anchor/anchor.cpp" "${_text}")
file(READ "${_ref}/Anchor/gsacak.c" _text)
string(REPLACE "step = 1; j = SA[i] - 1;" "step = 1; if (SA[i] <= 0) continue; j = SA[i] - 1;" _text "${_text}")
file(WRITE "${_ref}/Anchor/gsacak.c" "${_text}")
file(READ "${_ref}/Anchor/anchor.h" _text)
string(REPLACE "rare_match_pairs.begin() + rare_pair_index != rare_match_pairs.end()"
               "rare_pair_index < rare_match_pairs.size()" _text "${_text}")
file(WRITE "${_ref}/Anchor/anchor.h" "${_text}")
add_executable(ramag_rama_source_probe tests/rama_source_probe.cpp
  "${_ref}/Anchor/anchor.cpp" "${_ref}/Anchor/rare_match.cpp" "${_ref}/Anchor/gsacak.c"
  "${_ref}/Anchor/RMQ.cpp" "${_ref}/Utils/utils.cpp" "${_ref}/Logging/logging.cpp")
target_include_directories(ramag_rama_source_probe PRIVATE
  "${_ref}/Anchor" "${_ref}/Utils" "${_ref}/ThreadPool" "${_ref}/Logging")
target_compile_features(ramag_rama_source_probe PRIVATE cxx_std_17)
target_link_libraries(ramag_rama_source_probe PRIVATE Threads::Threads)
add_executable(ramag_rama_integration_probe tests/rama_source_probe.cpp)
target_compile_definitions(ramag_rama_integration_probe PRIVATE RAMAG_INTEGRATION_PROBE=1)
target_include_directories(ramag_rama_integration_probe SYSTEM PRIVATE third_party/rama/core)
target_link_libraries(ramag_rama_integration_probe PRIVATE RaMAG::centromere)
