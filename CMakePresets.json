{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with the centromere backend",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "RAMAG_BUILD_TESTS": "OFF",
        "RAMAG_ENABLE_CENTROMERE": "ON"
      }
    },
    {
      "name": "genome-only",
      "displayName": "Release genome-only binary",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/genome-only",
      "cacheVariables": {
        "RAMAG_ENABLE_CENTROMERE": "OFF"
      }
    },
    {
      "name": "testing",
      "displayName": "Release with public synthetic tests",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/testing",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "RAMAG_BUILD_TESTS": "ON",
        "RAMAG_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "genome-only",
      "configurePreset": "genome-only"
    },
    {
      "name": "testing",
      "configurePreset": "testing"
    }
  ],
  "testPresets": [
    {
      "name": "testing",
      "configurePreset": "testing",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
